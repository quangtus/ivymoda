<?php
/**
 * Chatbot AJAX Endpoint - UC3.48
 * 
 * Xử lý các request AJAX cho chatbot FAQ
 * 
 * Actions:
 * - get_faqs: Lấy danh sách FAQ
 * - search_faqs: Tìm kiếm FAQ
 * - get_faq_by_id: Lấy FAQ theo ID
 * - get_categories: Lấy danh sách categories
 */

// QUAN TRỌNG: Disable error display TRƯỚC KHI bất cứ output nào
error_reporting(0);
ini_set('display_errors', 0);
ini_set('display_startup_errors', 0);
ini_set('log_errors', 1);
ini_set('error_log', dirname(__DIR__, 2) . '/logs/chatbot_ajax_error.log');

// Start output buffering ĐẦU TIÊN
ob_start();

// Định nghĩa đường dẫn gốc
if (!defined('ROOT_PATH')) {
    define('ROOT_PATH', dirname(__DIR__, 2) . '/');
}

// Khởi động session
session_start();

// Set header JSON ngay từ đầu
header('Content-Type: application/json; charset=utf-8');

// Catch any PHP errors and convert to JSON
set_error_handler(function($errno, $errstr, $errfile, $errline) {
    ob_end_clean(); // Clear ALL output buffers
    error_log("PHP Error: [$errno] $errstr in $errfile on line $errline");
    echo json_encode(['success' => false, 'message' => 'Lỗi PHP: ' . $errstr], JSON_UNESCAPED_UNICODE);
    exit;
});

// Load dependencies
try {
    require_once ROOT_PATH . 'config/config.php';
    require_once ROOT_PATH . 'app/core/Database.php';
    require_once ROOT_PATH . 'app/core/Model.php';
    require_once ROOT_PATH . 'app/models/ChatbotFaqModel.php';
    require_once ROOT_PATH . 'app/models/ChatbotModel.php';
    require_once ROOT_PATH . 'app/services/GeminiService.php';
} catch (Exception $e) {
    // Clear output buffer và log error
    ob_end_clean();
    error_log('Chatbot AJAX Load Error: ' . $e->getMessage());
    echo json_encode(['success' => false, 'message' => 'Load error: ' . $e->getMessage()], JSON_UNESCAPED_UNICODE);
    exit;
}

// Kiểm tra method
if ($_SERVER['REQUEST_METHOD'] !== 'GET' && $_SERVER['REQUEST_METHOD'] !== 'POST') {
    echo json_encode(['success' => false, 'message' => 'Method not allowed']);
    exit;
}

// Initialize models
try {
    $chatbotFaqModel = new ChatbotFaqModel();
    $chatbotModel = new ChatbotModel();
} catch (Exception $e) {
    ob_end_clean();
    header('Content-Type: application/json; charset=utf-8');
    echo json_encode(['success' => false, 'message' => 'Model init error: ' . $e->getMessage()], JSON_UNESCAPED_UNICODE);
    exit;
}

// Lấy action từ GET hoặc POST body
$action = $_REQUEST['action'] ?? '';

// Nếu action không có trong GET, thử lấy từ POST body (JSON)
if (empty($action) && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $input = json_decode(file_get_contents('php://input'), true);
    $action = $input['action'] ?? '';
}

try {
    switch ($action) {
        case 'get_faqs':
            getFaqs($chatbotFaqModel);
            break;
        case 'search_faqs':
            searchFaqs($chatbotFaqModel);
            break;
        case 'get_faq_by_id':
            getFaqById($chatbotFaqModel);
            break;
        case 'get_categories':
            getCategories($chatbotFaqModel);
            break;
        // UC3.47 - Chatbot AI
        case 'chat_with_ai':
            chatWithAI($chatbotModel);
            break;
        case 'save_user_preferences':
            saveUserPreferences($chatbotModel);
            break;
        case 'get_conversation_history':
            getConversationHistory($chatbotModel);
            break;
        case 'test_gemini':
            testGemini($chatbotModel);
            break;
        default:
            ob_clean();
            echo json_encode(['success' => false, 'message' => 'Invalid action: ' . $action]);
            exit;
    }
} catch (Exception $e) {
    ob_clean();
    error_log('Chatbot AJAX Error: ' . $e->getMessage());
    echo json_encode(['success' => false, 'message' => 'Error: ' . $e->getMessage()]);
    exit;
}

// ============================================
// FUNCTIONS
// ============================================

/**
 * Lấy danh sách FAQ
 * 
 * GET params:
 * - category (optional): Danh mục FAQ
 * - status (optional): Trạng thái (1: Active, 0: Inactive)
 */
function getFaqs($chatbotFaqModel) {
    $category = $_GET['category'] ?? null;
    $status = $_GET['status'] ?? 1;
    
    $faqs = $chatbotFaqModel->getFaqs($category, (int)$status);
    
    // Format data cho frontend
    $formattedFaqs = [];
    foreach ($faqs as $faq) {
        $formattedFaqs[] = [
            'id' => $faq->faq_id,
            'question' => $faq->question,
            'answer' => $faq->answer,
            'category' => $faq->category,
            'display_order' => $faq->display_order,
            'help_link' => $faq->help_link,
            'created_at' => $faq->created_at
        ];
    }
    
    echo json_encode([
        'success' => true,
        'faqs' => $formattedFaqs,
        'total' => count($formattedFaqs),
        'category' => $category,
        'status' => $status
    ], JSON_UNESCAPED_UNICODE);
}

/**
 * Tìm kiếm FAQ theo từ khóa
 * 
 * GET params:
 * - keyword (required): Từ khóa tìm kiếm
 */
function searchFaqs($chatbotFaqModel) {
    $keyword = $_GET['keyword'] ?? '';
    
    if (empty($keyword)) {
        echo json_encode([
            'success' => false,
            'message' => 'Vui lòng nhập từ khóa tìm kiếm'
        ]);
        return;
    }
    
    $faqs = $chatbotFaqModel->searchFaqs($keyword);
    
    // Format data cho frontend
    $formattedFaqs = [];
    foreach ($faqs as $faq) {
        $formattedFaqs[] = [
            'id' => $faq->faq_id,
            'question' => $faq->question,
            'answer' => $faq->answer,
            'category' => $faq->category,
            'display_order' => $faq->display_order,
            'help_link' => $faq->help_link,
            'created_at' => $faq->created_at
        ];
    }
    
    echo json_encode([
        'success' => true,
        'faqs' => $formattedFaqs,
        'total' => count($formattedFaqs),
        'keyword' => $keyword
    ], JSON_UNESCAPED_UNICODE);
}

/**
 * Lấy FAQ theo ID
 * 
 * GET params:
 * - id (required): ID của FAQ
 */
function getFaqById($chatbotFaqModel) {
    $faqId = $_GET['id'] ?? 0;
    
    if (!$faqId) {
        echo json_encode([
            'success' => false,
            'message' => 'ID FAQ không hợp lệ'
        ]);
        return;
    }
    
    $faq = $chatbotFaqModel->getFaqById($faqId);
    
    if (!$faq) {
        echo json_encode([
            'success' => false,
            'message' => 'Không tìm thấy FAQ'
        ]);
        return;
    }
    
    echo json_encode([
        'success' => true,
        'faq' => [
            'id' => $faq->faq_id,
            'question' => $faq->question,
            'answer' => $faq->answer,
            'category' => $faq->category,
            'display_order' => $faq->display_order,
            'status' => $faq->status,
            'help_link' => $faq->help_link,
            'created_at' => $faq->created_at,
            'updated_at' => $faq->updated_at
        ]
    ], JSON_UNESCAPED_UNICODE);
}

/**
 * Lấy danh sách categories
 */
function getCategories($chatbotFaqModel) {
    $categories = $chatbotFaqModel->getCategories();
    
    $formattedCategories = [];
    foreach ($categories as $category) {
        $formattedCategories[] = $category->category;
    }
    
    echo json_encode([
        'success' => true,
        'categories' => $formattedCategories,
        'total' => count($formattedCategories)
    ], JSON_UNESCAPED_UNICODE);
}

// ============================================
// UC3.47 - CHATBOT AI FUNCTIONS
// ============================================

/**
 * Chat với Gemini AI
 * 
 * POST data:
 * - message: Tin nhắn từ người dùng
 * - session_id: Session ID (optional)
 */
function chatWithAI($chatbotModel) {
    try {
        // Kiểm tra method
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            ob_clean();
            echo json_encode(['success' => false, 'message' => 'Method not allowed']);
            exit;
        }
        
        // Lấy dữ liệu từ POST
        $input = json_decode(file_get_contents('php://input'), true);
        $userMessage = $input['message'] ?? '';
        $sessionId = $input['session_id'] ?? session_id();
        $userId = $_SESSION['user_id'] ?? null;
        
        if (empty($userMessage)) {
            ob_clean();
            echo json_encode(['success' => false, 'message' => 'Vui lòng nhập tin nhắn']);
            exit;
        }
        
        // Khởi tạo Gemini Service
        $apiKey = $chatbotModel->getConfig('gemini_api_key');
        if (!$apiKey) {
            ob_clean();
            echo json_encode(['success' => false, 'message' => 'Chatbot AI tạm thời không khả dụng']);
            exit;
        }
        
        $geminiService = new GeminiService($apiKey);
        
        // Lấy context từ database
        $context = buildContext($chatbotModel, $userId);
        
        // Đo thời gian phản hồi
        $startTime = microtime(true);
        
        // Gọi Gemini AI
        $aiResponse = $geminiService->generateResponse($userMessage, $context);
        
        $responseTime = round((microtime(true) - $startTime) * 1000);
        
        if (!$aiResponse['success']) {
            ob_clean();
            echo json_encode([
                'success' => false,
                'message' => $aiResponse['error'] ?? 'Chatbot AI tạm thời không khả dụng'
            ]);
            exit;
        }
        
        // Lưu lịch sử hội thoại
        $chatbotModel->saveConversation([
            'user_id' => $userId,
            'session_id' => $sessionId,
            'user_message' => $userMessage,
            'bot_response' => $aiResponse['response'],
            'context_data' => json_encode($context, JSON_UNESCAPED_UNICODE),
            'suggested_products' => json_encode($context['products'] ?? [], JSON_UNESCAPED_UNICODE),
            'response_time' => $responseTime,
            'is_from_faq' => 0
        ]);
        
        ob_clean();
        // Sanitize products array before JSON encoding
        $productsToReturn = [];
        if (isset($context['products']) && is_array($context['products'])) {
            foreach ($context['products'] as $product) {
                $productsToReturn[] = sanitizeArray($product);
            }
        }
        
        echo json_encode([
            'success' => true,
            'response' => $aiResponse['response'],
            'suggested_products' => $productsToReturn,
            'response_time' => $responseTime
        ], JSON_UNESCAPED_UNICODE);
        exit;
        
    } catch (Exception $e) {
        ob_clean();
        error_log('Chatbot AI Error: ' . $e->getMessage());
        echo json_encode([
            'success' => false,
            'message' => 'Lỗi hệ thống: ' . $e->getMessage()
        ]);
        exit;
    }
}

/**
 * Xây dựng context cho Gemini AI
 */
function buildContext($chatbotModel, $userId = null) {
    $context = [];
    
    // Lấy sản phẩm bán chạy
    $context['products'] = $chatbotModel->getPopularProducts(5);
    
    // Lấy danh mục
    $categories = $chatbotModel->getAvailableCategories();
    $context['categories'] = array_column($categories, 'danhmuc_ten');
    
    // Lấy màu sắc
    $colors = $chatbotModel->getAvailableColors();
    $context['colors'] = array_column($colors, 'color_ten');
    
    // Lấy size
    $sizes = $chatbotModel->getAvailableSizes();
    $context['sizes'] = array_column($sizes, 'size_ten');
    
    // Lấy sở thích người dùng nếu có
    if ($userId) {
        $preferences = $chatbotModel->getUserPreferences($userId);
        if ($preferences) {
            $context['user_preferences'] = [
                'favorite_colors' => $preferences->favorite_colors,
                'favorite_categories' => $preferences->favorite_categories,
                'size_preference' => $preferences->size_preference,
                'price_range' => $preferences->price_range,
                'skin_tone' => $preferences->skin_tone,
                'height' => $preferences->height
            ];
        }
    }
    
    return $context;
}

/**
 * Lưu sở thích người dùng
 */
function saveUserPreferences($chatbotModel) {
    try {
        if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
            echo json_encode(['success' => false, 'message' => 'Method not allowed']);
            return;
        }
        
        $userId = $_SESSION['user_id'] ?? null;
        if (!$userId) {
            echo json_encode(['success' => false, 'message' => 'Vui lòng đăng nhập']);
            return;
        }
        
        $input = json_decode(file_get_contents('php://input'), true);
        $input['user_id'] = $userId;
        
        $success = $chatbotModel->saveUserPreferences($input);
        
        if ($success) {
            echo json_encode(['success' => true, 'message' => 'Đã lưu sở thích']);
        } else {
            echo json_encode(['success' => false, 'message' => 'Lỗi khi lưu sở thích']);
        }
        
    } catch (Exception $e) {
        echo json_encode([
            'success' => false,
            'message' => 'Lỗi hệ thống: ' . $e->getMessage()
        ]);
    }
}

/**
 * Lấy lịch sử hội thoại
 */
function getConversationHistory($chatbotModel) {
    try {
        $sessionId = $_GET['session_id'] ?? session_id();
        $limit = $_GET['limit'] ?? 10;
        
        $history = $chatbotModel->getConversationHistory($sessionId, $limit);
        
        // Format dữ liệu
        $formattedHistory = [];
        foreach ($history as $conversation) {
            $formattedHistory[] = [
                'user_message' => $conversation->user_message,
                'bot_response' => $conversation->bot_response,
                'suggested_products' => json_decode($conversation->suggested_products, true) ?? [],
                'response_time' => $conversation->response_time,
                'is_from_faq' => $conversation->is_from_faq,
                'created_at' => $conversation->created_at
            ];
        }
        
        echo json_encode([
            'success' => true,
            'history' => $formattedHistory
        ], JSON_UNESCAPED_UNICODE);
        
    } catch (Exception $e) {
        echo json_encode([
            'success' => false,
            'message' => 'Lỗi khi lấy lịch sử: ' . $e->getMessage()
        ]);
    }
}

/**
 * Test kết nối Gemini AI
 */
function testGemini($chatbotModel) {
    try {
        $apiKey = $chatbotModel->getConfig('gemini_api_key');
        if (!$apiKey) {
            ob_clean();
            echo json_encode(['success' => false, 'message' => 'API key không được cấu hình']);
            exit;
        }
        
        $geminiService = new GeminiService($apiKey);
        $isConnected = $geminiService->testConnection();
        
        ob_clean();
        echo json_encode([
            'success' => $isConnected,
            'message' => $isConnected ? 'Kết nối Gemini AI thành công' : 'Không thể kết nối Gemini AI'
        ], JSON_UNESCAPED_UNICODE);
        exit;
        
    } catch (Exception $e) {
        ob_clean();
        error_log('Test Gemini Error: ' . $e->getMessage());
        echo json_encode([
            'success' => false,
            'message' => 'Lỗi khi test Gemini AI: ' . $e->getMessage()
        ]);
        exit;
    }
}

/**
 * Sanitize array để tránh lỗi JSON encoding
 */
function sanitizeArray($array) {
    if (!is_array($array)) {
        return sanitizeValue($array);
    }
    
    $sanitized = [];
    foreach ($array as $key => $value) {
        if (is_array($value)) {
            $sanitized[$key] = sanitizeArray($value);
        } else {
            $sanitized[$key] = sanitizeValue($value);
        }
    }
    return $sanitized;
}

/**
 * Sanitize single value
 */
function sanitizeValue($value) {
    if (!is_string($value)) {
        return $value;
    }
    
    // Remove control characters and invalid UTF-8
    $value = preg_replace('/[\x00-\x1F\x80-\x9F]/u', '', $value);
    
    // Trim excess whitespace
    $value = trim($value);
    
    return $value;
}

